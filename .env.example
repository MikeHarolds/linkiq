# ==============================
# LinkIQ — Root Environment Vars
# Copy to .env and fill in values.
# Consumed by docker/docker-compose.dev.yml and docker/docker-compose.prod.yml
# ==============================

# --- Postgres ---
POSTGRES_USER=linkiq
POSTGRES_PASSWORD=linkiq_dev_password
POSTGRES_DB=linkiq
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=

# --- API ---
API_PORT=4000

# --- Web ---
WEB_PORT=3000
