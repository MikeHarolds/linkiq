# LinkIQ Web — Production Environment Variables
NEXT_PUBLIC_API_URL=https://your-domain.example/api/v1
NEXT_PUBLIC_APP_URL=https://your-domain.example
# Server-only — the API's origin as reachable from the web server process
# itself, NOT the public domain (using the public domain here would proxy
# back through nginx into an unrouted loop). infrastructure/nginx/linkiq.conf
# runs both the web and api processes on the same host and upstreams the
# API at 127.0.0.1:4000, so that's what belongs here for that deployment
# model. In practice nginx already short-circuits short-link requests
# straight to the API (see linkiq.conf) — this rewrite is the fallback
# path for anything that reaches the web process directly.
API_ORIGIN=http://127.0.0.1:4000
