# LinkIQ Web — Production Environment Variables
NEXT_PUBLIC_API_URL=https://your-domain.example/api/v1
NEXT_PUBLIC_APP_URL=https://your-domain.example
# Must match the API's REFRESH_COOKIE_NAME.
NEXT_PUBLIC_REFRESH_COOKIE_NAME=linkiq_refresh_token
# Server-only — the API's origin as reachable from the web server
# process itself, NOT the public domain. Depends on deployment
# topology:
#   - Self-hosted, single host (infrastructure/nginx/linkiq.conf runs
#     both processes on the same host, nginx upstreams the API at
#     127.0.0.1:4000): API_ORIGIN=http://127.0.0.1:4000 — using the
#     public domain here would proxy back through nginx into an
#     unrouted loop. nginx already short-circuits short-link requests
#     straight to the API in that model; this rewrite is only the
#     fallback path for anything that reaches the web process directly.
#   - Render (or any deployment where the API is a SEPARATE service,
#     not the same host): API_ORIGIN must be that API service's own
#     public URL instead — see docs/deployment/render.md.
API_ORIGIN=http://127.0.0.1:4000
