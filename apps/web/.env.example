# LinkIQ Web — Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Must match apps/api's REFRESH_COOKIE_NAME — used by middleware.ts for
# optimistic route protection (presence check only, not validation).
NEXT_PUBLIC_REFRESH_COOKIE_NAME=linkiq_refresh_token
