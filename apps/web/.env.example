# LinkIQ Web — Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Must match apps/api's REFRESH_COOKIE_NAME — used by middleware.ts for
# optimistic route protection (presence check only, not validation).
NEXT_PUBLIC_REFRESH_COOKIE_NAME=linkiq_refresh_token
# Server-only (never sent to the browser) — the API's bare origin,
# reachable from Next's own server process, used by next.config.js's
# rewrite to proxy short-link redirects. Not the same as
# NEXT_PUBLIC_API_URL, which is browser-facing and includes /api/v1.
API_ORIGIN=http://localhost:4000
