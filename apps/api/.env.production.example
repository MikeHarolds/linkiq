# LinkIQ API — Production Environment Variables
# Copy to apps/api/.env.production and fill in real secrets.
# Never commit the real .env.production file.

NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=https://your-domain.example
LOG_LEVEL=info

DATABASE_URL="postgresql://linkiq:REPLACE_ME@postgres:5432/linkiq?schema=public"

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME

JWT_ACCESS_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
REFRESH_COOKIE_NAME=linkiq_refresh_token
COOKIE_DOMAIN=.your-domain.example
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

THROTTLE_TTL=60
THROTTLE_LIMIT=100
