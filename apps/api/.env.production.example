# LinkIQ API — Production Environment Variables
# Copy to apps/api/.env.production and fill in real secrets.
# Never commit the real .env.production file. See docs/deployment/render.md
# for how these map onto a real Render deployment (render.yaml at the repo
# root marks every one of these `sync: false` — filled in manually, never
# generated or guessed).

NODE_ENV=production
PORT=4000
API_PREFIX=api/v1
# No wildcard fallback exists for this — must be set to your deployed
# web app's exact origin, or the API rejects the browser's requests.
CORS_ORIGIN=https://your-domain.example
# Public-facing origin the web app is deployed at — used to build
# short-link/QR-code URLs and the Paystack checkout callback URL.
APP_URL=https://your-domain.example
LOG_LEVEL=info

DATABASE_URL="postgresql://linkiq:REPLACE_ME@postgres:5432/linkiq?schema=public"

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_ME

JWT_ACCESS_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
REFRESH_COOKIE_NAME=linkiq_refresh_token
COOKIE_DOMAIN=.your-domain.example
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Analytics ---
VISITOR_HASH_SALT=REPLACE_ME_WITH_A_LONG_RANDOM_VALUE
GEO_IP_PROVIDER=
# Reverse-proxy hops in front of the API in production (e.g. Nginx = 1,
# Nginx behind a CDN = 2) — see docs/architecture/analytics.md.
TRUSTED_PROXY_HOPS=1

# --- Custom Domains ---
REDIRECT_DEFAULT_HOSTS=
DOMAIN_VERIFICATION_MODE=dns

# --- Billing ---
# "paystack" for a real deployment — "development" (or unset) never
# calls Paystack at all and is not appropriate for production.
BILLING_PROVIDER=paystack
BILLING_PROVIDER_API_KEY=

# --- Payments: Paystack ---
# LIVE credentials for real production, TEST credentials for a Render
# staging/demo deployment — never mix the two. Mode is inferred
# automatically from this key's own sk_test_/sk_live_ prefix.
PAYSTACK_SECRET_KEY=REPLACE_ME_WITH_A_REAL_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=REPLACE_ME_WITH_A_REAL_PAYSTACK_PUBLIC_KEY
PAYSTACK_PAST_DUE_GRACE_DAYS=7

# --- Webhooks ---
WEBHOOK_SECRET_ENCRYPTION_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_VALUE
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_MS=1000
WEBHOOK_AUTO_DISABLE_THRESHOLD=10
# Must stay false/unset in production — this is a dev/test-only
# exception that allows plain "http://" webhook URLs pointed at
# loopback addresses.
WEBHOOK_ALLOW_HTTP_LOCALHOST=false

# --- File uploads (branding logo/favicon) ---
# Local-disk storage does not persist across an ephemeral/redeployed
# container (see docs/deployment/render.md §File storage). Set to this
# API service's own public URL, used to build absolute uploaded-file URLs.
API_PUBLIC_URL=https://your-api-domain.example
UPLOAD_DIR=

# --- Demo accounts ---
# Intentionally NOT set here — `npm run db:seed` (which reads these) is
# a development-only tool and must never be run against a production
# database. See the README's "Seeding" section.
