// LinkIQ — Prisma Schema
// Foundation milestone: only the models needed to support authentication,
// multi-tenancy, and RBAC are defined here. Link, Campaign, QR Code,
// Analytics, Billing, and Webhook models are introduced in later milestones
// so each milestone stays reviewable and scoped.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum GlobalRole {
  SUPER_ADMIN // Platform-level administrator (LinkIQ staff)
  USER // Regular platform user
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Stored lifecycle states for a Link. Deliberately does NOT include an
/// EXPIRED value — expiry is derived from `expiresAt` at read time instead
/// of being a stored state. Storing EXPIRED would require a background job
/// to flip status the instant `expiresAt` passes, and any lag in that job
/// would let an expired link keep redirecting. Deriving it means expiry is
/// always correct without needing a scheduler in the loop.
enum LinkStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Lifecycle of a workspace's custom (branded) domain. Only ACTIVE domains
/// are eligible to serve redirects — see RedirectService/DomainResolverService.
/// PENDING: created, token generated, no verification attempt made yet.
/// VERIFYING: a verification check is in flight (transient — the current
/// synchronous DNS-TXT provider passes through this immediately, but the
/// state exists so an async provider can sit in it for longer).
/// VERIFIED: ownership confirmed, not yet serving traffic.
/// ACTIVE: verified AND explicitly activated — the only state that resolves
/// redirects.
/// FAILED: the last verification attempt didn't find the expected record;
/// eligible for retry.
/// DISABLED: previously ACTIVE, explicitly turned off — links keep their
/// association but stop resolving until re-activated.
enum DomainStatus {
  PENDING
  VERIFYING
  VERIFIED
  ACTIVE
  FAILED
  DISABLED
}

/// Fixed pricing tiers (Sprint 7). Distinct from Plan.slug: slug is the
/// unique lookup key for a specific priced offering, tier is the coarser
/// "which bracket is this" identity code that application logic branches
/// on (e.g. "is this workspace on the free tier"). Not final commercial
/// pricing — see docs/architecture/billing.md.
enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

/// Keys for the structured plan-limit mechanism — see PlanLimit. Every
/// module that gates a resource on a plan asks BillingUsageService about
/// exactly one of these; no module hard-codes numeric limits itself.
enum PlanLimitKey {
  MAX_LINKS
  MAX_QR_CODES
  MAX_CAMPAIGNS
  MAX_CUSTOM_DOMAINS
  MAX_TEAM_MEMBERS
  MONTHLY_CLICKS
  ANALYTICS_RETENTION_DAYS
  /// Sprint 8 — monthly quota for API-key-authenticated requests. Never
  /// enforced against browser JWT traffic or the public redirect path,
  /// see docs/architecture/api-keys.md.
  MONTHLY_API_REQUESTS
  /// Sprint 9 — enforced at webhook endpoint creation, see
  /// docs/architecture/webhooks.md.
  MAX_WEBHOOK_ENDPOINTS
  /// Sprint 9 — tracked on the usage dashboard only, never enforced
  /// (same "informational, never blocking" treatment as MONTHLY_CLICKS)
  /// — see docs/architecture/billing.md and docs/architecture/webhooks.md.
  MONTHLY_WEBHOOK_DELIVERIES
}

/// Scoped capabilities an API key can be granted at creation (Sprint 8).
/// Deliberately independent of WorkspaceRole — an API key's authority is
/// this list, never the creator's ongoing workspace role. See
/// docs/architecture/api-keys.md.
enum ApiKeyPermission {
  LINKS_READ
  LINKS_WRITE
  CAMPAIGNS_READ
  CAMPAIGNS_WRITE
  QRCODES_READ
  QRCODES_WRITE
  ANALYTICS_READ
  DOMAINS_READ
  DOMAINS_WRITE
  WORKSPACE_READ
  /// Sprint 9 — see docs/architecture/webhooks.md.
  WEBHOOKS_READ
  WEBHOOKS_WRITE
}

/// Lifecycle of a workspace's Subscription. Deliberately does NOT store
/// "trial expired" or "cancellation reached" as distinct persisted
/// transitions for their own sake — see getEffectiveStatus() in
/// billing/utils/effective-status.ts, which derives those two cases from
/// `trialEnd`/`cancelAt` at read time, the same principle LinkStatus (see
/// above) and CampaignStatus already use, so no scheduler is needed to
/// keep the system logically correct.
/// TRIALING: on a plan's trial period, not yet charged.
/// ACTIVE: normal paid (or free) access.
/// PAST_DUE: provider reported a failed payment; access continues short-term.
/// PAUSED: temporarily suspended (workspace- or provider-initiated).
/// CANCELED: cancellation has taken effect (see cancelAt on Subscription).
/// EXPIRED: a trial ended without converting to a paid/free subscription.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

/// Processing state for an inbound BillingEvent (webhook) row.
enum BillingEventStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  /// Sprint 10 — a paid invoice whose charge was refunded (in full or in
  /// part) via the payment provider. VOID means "never collected"; this
  /// means "was collected, then given back" — a different, real state
  /// the existing enum had no accurate value for.
  REFUNDED
}

// ---------------------------------------------------------------------------
// Identity & Multi-tenancy
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatarUrl     String?
  globalRole    GlobalRole @default(USER)
  isActive      Boolean    @default(true)
  emailVerified Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships             WorkspaceMember[]
  ownedOrgs               Organization[]       @relation("OrganizationOwner")
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  createdLinks            Link[]               @relation("LinkCreator")
  createdQrCodes          QrCode[]             @relation("QrCodeCreator")
  createdCampaigns        Campaign[]           @relation("CampaignCreator")
  createdCustomDomains    CustomDomain[]       @relation("CustomDomainCreator")
  createdApiKeys          ApiKey[]             @relation("ApiKeyCreator")
  createdWebhookEndpoints WebhookEndpoint[]    @relation("WebhookEndpointCreator")

  @@index([email])
  @@map("users")
}

model Organization {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  slug    String @unique
  ownerId String @db.Uuid
  owner   User   @relation("OrganizationOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces Workspace[]

  @@index([ownerId])
  @@map("organizations")
}

model Workspace {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  slug           String
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          WorkspaceMember[]
  auditLogs        AuditLog[]
  links            Link[]
  qrCodes          QrCode[]
  campaigns        Campaign[]
  customDomains    CustomDomain[]
  subscription     Subscription?
  invoices         Invoice[]
  apiKeys          ApiKey[]
  apiUsageEvents   ApiUsageEvent[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEvent[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// Authentication sessions & password recovery
// ---------------------------------------------------------------------------

/// One row per issued refresh token (i.e. per active session). The raw
/// token is never stored — only a SHA-256 hash — so a database leak alone
/// can't be used to forge sessions. Rotated on every /auth/refresh call;
/// revoked (not deleted) on logout so a re-used stolen token is detectable.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// One row per requested password reset. The raw token is only ever sent
/// to the user (via the dev-mode log/email stub); only its hash is stored.
/// `usedAt` is set on successful reset so the same token can't be replayed.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Campaign Management
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

/// A workspace-scoped organizational/analytics grouping for links. A
/// campaign is deliberately NOT a redirect or tracking mechanism of its
/// own — it has no shortCode and is never itself hit by a browser. It
/// exists purely to (a) group links for reporting and (b) provide UTM
/// defaults new links in it can inherit. See docs/architecture/campaigns.md.
///
/// Deleting/archiving a campaign never touches its links — see the
/// `campaign` relation on Link (onDelete: SetNull) — link availability
/// stays entirely governed by the Link system, unaffected by campaign
/// status, per this sprint's explicit design requirement.
model Campaign {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?

  /// UTM defaults new links assigned to this campaign inherit at creation
  /// time (a one-time snapshot onto the link — see Link.utmSource et al.
  /// for why this isn't a live lookup).
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  createdById String? @db.Uuid
  createdBy   User?   @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  links Link[]

  @@index([workspaceId])
  @@index([status])
  @@index([createdById])
  @@map("campaigns")
}

// ---------------------------------------------------------------------------
// Custom Domains (Sprint 6)
// ---------------------------------------------------------------------------

/// A workspace-owned branded domain (e.g. go.acme.com) that can serve as the
/// public host for that workspace's links, as an alternative to the default
/// LinkIQ host — see DomainResolverService/RedirectService for how an
/// incoming Host header is resolved back to a workspace and, from there, to
/// a Link. Verification is DNS-TXT based (see DomainVerificationProvider);
/// LinkIQ never mutates DNS records itself.
///
/// `normalizedDomain` is globally `@unique` (not scoped, not partial),
/// deliberately mirroring `Link.shortCode`'s convention: once a domain is
/// registered, it's retired forever even after soft-delete, which is the
/// simplest possible way to guarantee both "a workspace can't register the
/// same domain twice" and "the same domain can never be attached to two
/// workspaces at once" without a partial unique index.
model CustomDomain {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// As entered by the user, preserved for display.
  domain           String
  /// Lowercased/trimmed form used for lookups and uniqueness.
  normalizedDomain String       @unique
  status           DomainStatus @default(PENDING)

  /// Random per-domain secret the user publishes as a
  /// `_linkiq-verification.<domain>` TXT record to prove ownership.
  verificationToken     String
  verificationCheckedAt DateTime?
  verifiedAt            DateTime?

  /// At most one non-deleted domain per workspace may have this set —
  /// enforced in DomainsService.setPrimary via a transaction (unset the
  /// previous primary, then set the new one), the same app-level-invariant
  /// style as WorkspacesService.assertNotLastOwner, rather than a DB
  /// constraint.
  isPrimary Boolean @default(false)

  createdById String? @db.Uuid
  createdBy   User?   @relation("CustomDomainCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  links Link[]

  @@index([workspaceId])
  @@index([workspaceId, isPrimary])
  @@map("custom_domains")
}

// ---------------------------------------------------------------------------
// Link Management
// ---------------------------------------------------------------------------

/// A shortened link. `shortCode` is globally unique (not per-workspace) —
/// the public redirect route is GET /{shortCode} with no workspace
/// disambiguation in the URL, so the code must resolve unambiguously across
/// the whole platform, the same way real-world shorteners work.
model Link {
  id             String     @id @default(uuid()) @db.Uuid
  workspaceId    String     @db.Uuid
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById    String?    @db.Uuid
  createdBy      User?      @relation("LinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  destinationUrl String
  shortCode      String     @unique
  title          String?
  description    String?
  status         LinkStatus @default(ACTIVE)
  /// Denormalized fast-path flag for the redirect hot path: true iff
  /// status = ACTIVE. Kept in sync by the application on every status
  /// transition. Lets the redirect query and its supporting index avoid an
  /// enum comparison — a plain boolean partial index is the cheapest
  /// possible filter for the single highest-volume query in the system.
  isActive       Boolean    @default(true)
  expiresAt      DateTime?

  /// Optional campaign association (Sprint 5). A link belongs to zero or
  /// one campaign. Deliberately SetNull, not Cascade: deleting/archiving a
  /// campaign must never delete or disable the links that reference it
  /// (see docs/architecture/campaigns.md) — the link simply becomes
  /// campaign-less again, exactly like it was before assignment.
  campaignId String?   @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// Optional branded-domain association (Sprint 6). Nullable: a link with
  /// no custom domain resolves through the default LinkIQ host exactly as
  /// before this sprint. Deliberately SetNull, not Cascade, for the same
  /// reason as `campaign` above — deleting/disabling a domain must never
  /// delete or disable the links that reference it (DomainsService also
  /// nulls this out explicitly at soft-delete time, since a soft delete
  /// doesn't trigger the DB-level SetNull).
  customDomainId String?       @db.Uuid
  customDomain   CustomDomain? @relation(fields: [customDomainId], references: [id], onDelete: SetNull)

  /// UTM values resolved and stored on the link at create/update time —
  /// either explicit overrides or inherited from the campaign's defaults
  /// at that moment. Deliberately a snapshot, not a live lookup: editing a
  /// campaign's UTM defaults later does NOT retroactively change already-
  /// configured links ("do not mutate existing URLs unexpectedly" — see
  /// docs/architecture/campaigns.md §UTM resolution). Applied to
  /// destinationUrl dynamically at redirect time (RedirectService), never
  /// baked into the stored destinationUrl itself — editing destinationUrl
  /// later keeps working exactly as it did before this sprint.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  clickEvents ClickEvent[]
  dailyStats  LinkDailyStat[]
  qrCodes     QrCode[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([campaignId])
  @@index([customDomainId])
  // Composite index for the redirect hot path: WHERE shortCode = ? AND
  // "deletedAt" IS NULL is the exact predicate the redirect resolver uses.
  @@index([shortCode, deletedAt])
  @@map("links")
}

/// Foundation for the future analytics engine (Sprint 3+). Written
/// asynchronously via a BullMQ job enqueued from the redirect path — never
/// written synchronously inline with a redirect response, so a slow
/// analytics write can never slow down a redirect.
/// One row per successful redirect, enriched asynchronously by the
/// analytics worker (see modules/analytics/processors/click-event.processor.ts).
/// `id` is generated by the PRODUCER (RedirectService), not the database —
/// this is what makes processing idempotent: if a BullMQ job is retried,
/// the same `id` is reused, so a retried write is a harmless no-op against
/// the unique primary key instead of a duplicate row.
///
/// Privacy: no raw IP address is ever persisted. `visitorHash` is a salted,
/// one-way hash of (IP + User-Agent + calendar day) computed at ingestion
/// time — see VisitorHashService for the full rationale and limitations.
model ClickEvent {
  id          String   @id @default(uuid()) @db.Uuid
  linkId      String   @db.Uuid
  link        Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  /// Denormalized from the link at write time so workspace-scoped click
  /// queries don't need to join through Link.
  workspaceId String   @db.Uuid
  occurredAt  DateTime @default(now())

  /// Salted SHA-256 of (ip + userAgent + UTC day) — never the raw IP. Two
  /// events with the same hash on the same day are treated as one visitor.
  visitorHash String

  country String?
  region  String?
  city    String?

  deviceType String? // 'desktop' | 'mobile' | 'tablet' | 'bot' | 'unknown'
  os         String?
  browser    String?
  userAgent  String? @db.VarChar(512)

  referrerUrl      String? @db.VarChar(2048)
  referrerDomain   String?
  referrerCategory String? // 'direct' | 'search' | 'social' | 'referral' | 'other'

  /// Only recognized marketing params (utm_*) are captured — never
  /// arbitrary query strings, which could carry PII (emails, tokens, ...).
  queryParams Json?

  isBot Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([linkId])
  @@index([workspaceId])
  @@index([occurredAt])
  @@index([workspaceId, occurredAt])
  @@index([linkId, occurredAt])
  @@map("click_events")
}

/// UTC-day rollup of ClickEvent, maintained incrementally by the analytics
/// worker in the same transaction as each event insert. Exists purely as a
/// fast path for the most frequently-rendered chart (clicks over time) —
/// every other breakdown (referrers, geography, devices, ...) is computed
/// directly from ClickEvent, which stays the single source of truth. This
/// table is UTC-only by design; a non-UTC timezone request recomputes from
/// raw events instead of trusting this rollup (see AnalyticsService).
///
/// If event volume ever outgrows Postgres, ClickEvent is the table that
/// would move to a column store like ClickHouse — this rollup, being tiny
/// by comparison, would likely stay in Postgres either way.
model LinkDailyStat {
  id          String   @id @default(uuid()) @db.Uuid
  linkId      String   @db.Uuid
  link        Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  workspaceId String   @db.Uuid
  /// Calendar day in UTC (stored at midnight UTC).
  date        DateTime @db.Date
  totalClicks Int      @default(0)
  humanClicks Int      @default(0)
  botClicks   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([linkId, date])
  @@index([workspaceId, date])
  @@map("link_daily_stats")
}

// ---------------------------------------------------------------------------
// QR Codes
// ---------------------------------------------------------------------------

enum QrFormat {
  PNG
  SVG
}

enum QrErrorCorrectionLevel {
  L
  M
  Q
  H
}

/// A QR code always encodes the LinkIQ short URL (e.g.
/// https://linkiq.example/abc123) — never the link's destinationUrl
/// directly. This is deliberate: the destination can change at any time
/// (LinksService.update) without invalidating or needing to regenerate
/// any QR code that points at it, since the short URL itself never
/// changes. See docs/architecture/qr-codes.md for the full rationale,
/// including how QR-originated traffic is distinguished from other
/// traffic using the existing UTM-capture mechanism rather than a new
/// tracking pipeline.
///
/// No image bytes are stored here — PNG/SVG output is generated
/// on-demand from this configuration (see QrCodeGeneratorService), which
/// is what "format" below really means: the default render format for
/// this record, not evidence that a file exists somewhere. Generation is
/// fast and fully deterministic from these columns, so there is nothing
/// to keep in sync if a color or size is edited.
model QrCode {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  linkId      String    @db.Uuid
  link        Link      @relation(fields: [linkId], references: [id], onDelete: Cascade)

  name   String
  format QrFormat @default(PNG)

  /// Pixel width/height of the (square) output image. SVG output uses
  /// this as its viewBox dimension too, for consistent preview sizing
  /// regardless of format.
  size                 Int                    @default(512)
  foregroundColor      String                 @default("#000000")
  backgroundColor      String                 @default("#FFFFFF")
  errorCorrectionLevel QrErrorCorrectionLevel @default(M)
  /// Quiet-zone width in "modules" (QR code units), matching the
  /// `qrcode` library's own margin option — not pixels.
  margin               Int                    @default(4)

  createdById String? @db.Uuid
  createdBy   User?   @relation("QrCodeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([workspaceId])
  @@index([linkId])
  @@index([createdById])
  @@map("qr_codes")
}

// ---------------------------------------------------------------------------
// Platform / Admin
// ---------------------------------------------------------------------------

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?    @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

// ---------------------------------------------------------------------------
// Billing & Subscriptions (Sprint 7)
// ---------------------------------------------------------------------------

/// A purchasable pricing tier. Deliberately provider-agnostic — nothing
/// here references Stripe/Paddle/etc.; see Subscription.provider* for
/// where external-provider identifiers live. Pricing/limits are plain
/// data (seeded, see prisma/seed.ts), never scattered across application
/// code. Not final commercial pricing — see docs/architecture/billing.md.
model Plan {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  /// Canonical lookup key (e.g. "free", "professional") — unique the same
  /// way Workspace/Organization slugs are, retired forever once used
  /// (same shortCode/normalizedDomain convention as Links/Custom Domains).
  slug            String          @unique
  tier            PlanTier
  description     String?
  /// Smallest currency unit (cents) — 0 for FREE. Never a float, to avoid
  /// rounding drift in a value that will eventually flow to a real
  /// payment provider.
  priceAmount     Int
  currency        String          @default("USD")
  billingInterval BillingInterval @default(MONTHLY)
  /// Days of trial access granted on a fresh subscribe to this plan; null
  /// = no trial offered (e.g. FREE, ENTERPRISE).
  trialDays       Int?
  isActive        Boolean         @default(true)
  displayOrder    Int             @default(0)

  /// Sprint 10 — the corresponding Paystack (or future provider) plan
  /// code, e.g. "PLN_xxxx". Null for plans that aren't purchasable
  /// through automated checkout (FREE, ENTERPRISE — see
  /// docs/architecture/paystack-integration.md). One new column here
  /// rather than a join table: a plan has at most one active provider
  /// plan code at a time, the same 1:1 shape Subscription's provider*
  /// columns already use.
  providerPlanId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  limits        PlanLimit[]
  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

/// One row per (plan, limit key). A missing row for a given key is
/// treated as unlimited by BillingUsageService (fail-open) — see that
/// service's docs for the rationale. `value: null` is the explicit,
/// intentional way to mark a key unlimited; `value: 0` disables the
/// feature entirely (e.g. MAX_CUSTOM_DOMAINS on the FREE plan).
model PlanLimit {
  id     String       @id @default(uuid()) @db.Uuid
  planId String       @db.Uuid
  plan   Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  key    PlanLimitKey
  value  Int?

  @@unique([planId, key])
  @@map("plan_limits")
}

/// A workspace's current subscription — deliberately exactly one per
/// workspace (`workspaceId` is unique), created transactionally alongside
/// every workspace (see SubscriptionsService.createDefaultSubscription,
/// called from both AuthService.register and WorkspacesService.create) so
/// a workspace can never exist without one. See getEffectiveStatus() for
/// how TRIALING/cancellation-pending states resolve to their eventual
/// EXPIRED/CANCELED outcome without a background job.
model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @unique @db.Uuid
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId      String             @db.Uuid
  plan        Plan               @relation(fields: [planId], references: [id])
  status      SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?

  trialStart DateTime?
  trialEnd   DateTime?

  /// When a pending cancellation takes effect — access continues normally
  /// until this passes (spec: cancel at end of billing period, not
  /// immediately). Null means no cancellation is pending.
  cancelAt   DateTime?
  /// When cancellation was requested — distinct from cancelAt (the
  /// effective date); kept for an audit trail even after reactivation.
  canceledAt DateTime?

  /// Sprint 10 — set when a recurring charge fails (status flips to
  /// PAST_DUE), cleared on the next successful charge. Lets
  /// getEffectiveStatus() derive PAST_DUE -> EXPIRED once this is older
  /// than the configured grace period, the same lazy/no-cron pattern
  /// already used for TRIALING -> EXPIRED and cancelAt -> CANCELED —
  /// see effective-status.ts.
  pastDueSince DateTime?

  /// Null = no external payment provider involved (dev-only / free
  /// subscriptions, which is everything in this sprint). Generic
  /// provider-agnostic naming throughout, deliberately not
  /// Stripe-specific, so a real provider integration only ever needs to
  /// populate these columns, never add new ones.
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  providerPriceId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

/// Idempotency ledger for inbound billing-provider events (webhooks). No
/// real webhook HTTP endpoint exists yet in this sprint — this is the
/// internal architecture a future receiver writes through — but the
/// unique constraint below is what actually prevents a duplicate
/// delivery from being processed twice, which is the part that has to
/// exist before any receiver can be trusted.
model BillingEvent {
  id              String             @id @default(uuid()) @db.Uuid
  provider        String
  /// The provider's own event ID — this plus `provider` is the real
  /// idempotency key; see @@unique below and BillingEventsService.
  externalEventId String
  eventType       String
  status          BillingEventStatus @default(PENDING)
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  /// Reference metadata only — never card numbers/secrets. Providers
  /// don't send those in webhook bodies, and nothing here re-derives or
  /// stores payment-method details even if a payload happened to include
  /// something sensitive-looking.
  payload         Json?
  errorMessage    String?

  @@unique([provider, externalEventId])
  @@index([status])
  @@map("billing_events")
}

/// Billing-history/invoice record. Existing purely as architecture this
/// sprint — no row is ever created with status PAID unless a real payment
/// actually happened, and none does yet (see prisma/seed.ts, which seeds
/// zero invoices for exactly this reason).
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  workspaceId    String        @db.Uuid
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriptionId String?       @db.Uuid
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /// Human-readable reference, unique per workspace (e.g. "DEV-0001").
  number   String
  amount   Int
  currency String        @default("USD")
  status   InvoiceStatus @default(DRAFT)

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  paidAt    DateTime?

  provider          String?
  providerInvoiceId String?
  hostedInvoiceUrl  String?

  /// Sprint 10 — why this invoice/charge failed (e.g. the provider's
  /// gateway_response), surfaced on the dashboard and to support. Null
  /// for anything that never failed.
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, number])
  @@index([workspaceId])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// API Keys & Developer API Access (Sprint 8)
// ---------------------------------------------------------------------------

/// A workspace-scoped credential external applications use in place of a
/// browser JWT session — see docs/architecture/api-keys.md. Only the
/// one-way hash of the secret is ever persisted; the raw secret exists
/// only in the response of the single request that created it.
model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String

  /// Non-secret display prefix (e.g. "lk_live_ab12cd34") — safe to show
  /// in the UI/logs/audit metadata. Unique because it's derived from the
  /// unique secret, not because uniqueness is itself required for lookup
  /// (keyHash is the actual lookup key).
  keyPrefix String @unique
  /// sha256(full raw key) — see common/utils/api-key.ts. Never the raw
  /// key, never reversible.
  keyHash   String @unique

  /// Fixed-vocabulary scopes this key was granted at creation time.
  /// Independent of the creator's ongoing WorkspaceRole — see
  /// WorkspaceRolesGuard's API-key branch.
  permissions ApiKeyPermission[]

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usageEvents ApiUsageEvent[]

  @@index([workspaceId])
  @@map("api_keys")
}

/// One row per API request made with an API key — written asynchronously
/// off the request path (see modules/api-keys/queue/), the same
/// producer/processor pattern as ClickEvent. Powers both the
/// MONTHLY_API_REQUESTS billing check (an aggregate count, mirroring
/// BillingUsageService's MONTHLY_CLICKS) and future usage analytics.
/// Deliberately never records the key secret, the Authorization header,
/// or request/response bodies.
model ApiUsageEvent {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// SetNull (not Cascade): a deleted key's historical usage stays
  /// available for billing history, the same way a workspace's billing
  /// history isn't erased by unrelated cleanup elsewhere.
  apiKeyId    String?   @db.Uuid
  apiKey      ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  endpoint   String
  method     String
  statusCode Int
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([apiKeyId])
  @@map("api_usage_events")
}

// ---------------------------------------------------------------------------
// Webhooks & Event Delivery (Sprint 9)
// ---------------------------------------------------------------------------

enum WebhookEndpointStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  EXHAUSTED
}

/// The webhook event catalog. SCREAMING_SNAKE Prisma values map 1:1 to
/// dotted wire strings ("link.created") via the lookup table in
/// webhooks/event-catalog.ts — a Prisma enum (not a plain string) so
/// WebhookEndpoint.events can be a native Postgres array with the same
/// query shape ApiKeyPermission[] already established in Sprint 8, and so
/// WebhookEvent.type stays indexable/exhaustively-checkable. WEBHOOK_TEST
/// is never a real domain event — see docs/architecture/webhooks.md §Test.
enum WebhookEventType {
  LINK_CREATED
  LINK_UPDATED
  LINK_DELETED
  LINK_PAUSED
  LINK_ACTIVATED
  LINK_ARCHIVED
  LINK_CLICKED
  QRCODE_CREATED
  QRCODE_UPDATED
  QRCODE_DELETED
  CAMPAIGN_CREATED
  CAMPAIGN_UPDATED
  CAMPAIGN_DELETED
  CAMPAIGN_ACTIVATED
  CAMPAIGN_PAUSED
  CAMPAIGN_ARCHIVED
  DOMAIN_CREATED
  DOMAIN_VERIFIED
  DOMAIN_ACTIVATED
  DOMAIN_DISABLED
  DOMAIN_DELETED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_PLAN_CHANGED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_REACTIVATED
  BILLING_LIMIT_REACHED
  API_KEY_CREATED
  API_KEY_REVOKED
  API_KEY_DELETED
  WEBHOOK_TEST
}

/// A workspace-scoped destination for signed HTTP event notifications.
/// Unlike an API key (which only ever needs to be *verified* against a
/// caller-supplied value, so a one-way hash suffices), a webhook secret
/// must be *used* by LinkIQ itself, repeatedly, to HMAC-sign every future
/// delivery — a one-way hash cannot support that. secretCiphertext is
/// therefore AES-256-GCM ciphertext (WebhookSecretCipherService), not a
/// hash, decrypted only inside the delivery worker at the moment of
/// signing. Soft-deleted (not hard-deleted) so delivery history survives
/// "deletion", matching Link/Campaign/CustomDomain's convention.
model WebhookEndpoint {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  url         String

  /// Non-secret display prefix (e.g. "whsec_ab12cd34") — safe to show in
  /// the UI/audit metadata. secretCiphertext is the encrypted full
  /// secret — never logged, never returned from any GET endpoint, never
  /// included in audit metadata. See class docs above.
  secretPrefix     String
  secretCiphertext String

  /// Subscribed event types — see WebhookEventType. A delivery is only
  /// ever created for an ACTIVE endpoint whose events[] contains the
  /// emitted type (see WebhookEventsService.emit).
  events WebhookEventType[]

  status WebhookEndpointStatus @default(ACTIVE)

  /// Drives automatic disablement (docs/architecture/webhooks.md §21) —
  /// incremented once per delivery that reaches a terminal failure
  /// (EXHAUSTED), reset to 0 on any successful delivery. Not a count of
  /// individual retry attempts.
  consecutiveFailures Int @default(0)

  lastDeliveryAt DateTime?
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("WebhookEndpointCreator", fields: [createdById], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([workspaceId])
  @@map("webhook_endpoints")
}

/// One immutable record of "this thing happened" — created exactly once
/// per logical occurrence, with a globally unique, application-generated
/// id ("evt_..."). Multiple WebhookDelivery rows can reference the same
/// WebhookEvent (one per subscribed endpoint), so every endpoint
/// receiving the same event gets byte-identical payload data and the
/// exact same event id on every retry — see docs/architecture/webhooks.md.
model WebhookEvent {
  id          String           @id
  workspaceId String           @db.Uuid
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        WebhookEventType
  resourceId  String?
  payload     Json

  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([workspaceId, createdAt])
  @@map("webhook_events")
}

/// One endpoint's attempt(s) to receive one WebhookEvent. Unique on
/// (webhookEndpointId, eventId) so a retry (automatic or manual) can
/// never create a second logical delivery row — every retry increments
/// attemptCount on this same row instead. See
/// webhooks/queue/webhook-delivery.processor.ts.
model WebhookDelivery {
  id                String           @id @default(uuid()) @db.Uuid
  webhookEndpointId String           @db.Uuid
  webhookEndpoint   WebhookEndpoint  @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  eventId           String
  event             WebhookEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventType         WebhookEventType

  attemptCount   Int                   @default(0)
  status         WebhookDeliveryStatus @default(PENDING)
  responseStatus Int?
  responseTimeMs Int?
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  failureReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([webhookEndpointId, eventId])
  @@index([webhookEndpointId, createdAt])
  @@index([status])
  @@map("webhook_deliveries")
}
