// LinkIQ — Prisma Schema
// Foundation milestone: only the models needed to support authentication,
// multi-tenancy, and RBAC are defined here. Link, Campaign, QR Code,
// Analytics, Billing, and Webhook models are introduced in later milestones
// so each milestone stays reviewable and scoped.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum GlobalRole {
  SUPER_ADMIN // Platform-level administrator (LinkIQ staff)
  USER // Regular platform user
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Stored lifecycle states for a Link. Deliberately does NOT include an
/// EXPIRED value — expiry is derived from `expiresAt` at read time instead
/// of being a stored state. Storing EXPIRED would require a background job
/// to flip status the instant `expiresAt` passes, and any lag in that job
/// would let an expired link keep redirecting. Deriving it means expiry is
/// always correct without needing a scheduler in the loop.
enum LinkStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Identity & Multi-tenancy
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatarUrl     String?
  globalRole    GlobalRole @default(USER)
  isActive      Boolean    @default(true)
  emailVerified Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         WorkspaceMember[]
  ownedOrgs           Organization[]       @relation("OrganizationOwner")
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  createdLinks        Link[]               @relation("LinkCreator")

  @@index([email])
  @@map("users")
}

model Organization {
  id      String @id @default(uuid()) @db.Uuid
  name    String
  slug    String @unique
  ownerId String @db.Uuid
  owner   User   @relation("OrganizationOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces Workspace[]

  @@index([ownerId])
  @@map("organizations")
}

model Workspace {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  slug           String
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   WorkspaceMember[]
  auditLogs AuditLog[]
  links     Link[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// Authentication sessions & password recovery
// ---------------------------------------------------------------------------

/// One row per issued refresh token (i.e. per active session). The raw
/// token is never stored — only a SHA-256 hash — so a database leak alone
/// can't be used to forge sessions. Rotated on every /auth/refresh call;
/// revoked (not deleted) on logout so a re-used stolen token is detectable.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// One row per requested password reset. The raw token is only ever sent
/// to the user (via the dev-mode log/email stub); only its hash is stored.
/// `usedAt` is set on successful reset so the same token can't be replayed.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Link Management
// ---------------------------------------------------------------------------

/// A shortened link. `shortCode` is globally unique (not per-workspace) —
/// the public redirect route is GET /{shortCode} with no workspace
/// disambiguation in the URL, so the code must resolve unambiguously across
/// the whole platform, the same way real-world shorteners work.
model Link {
  id             String     @id @default(uuid()) @db.Uuid
  workspaceId    String     @db.Uuid
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById    String?    @db.Uuid
  createdBy      User?      @relation("LinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  destinationUrl String
  shortCode      String     @unique
  title          String?
  description    String?
  status         LinkStatus @default(ACTIVE)
  /// Denormalized fast-path flag for the redirect hot path: true iff
  /// status = ACTIVE. Kept in sync by the application on every status
  /// transition. Lets the redirect query and its supporting index avoid an
  /// enum comparison — a plain boolean partial index is the cheapest
  /// possible filter for the single highest-volume query in the system.
  isActive  Boolean   @default(true)
  expiresAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  clickEvents ClickEvent[]

  @@index([workspaceId])
  @@index([createdById])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
  // Composite index for the redirect hot path: WHERE shortCode = ? AND
  // "deletedAt" IS NULL is the exact predicate the redirect resolver uses.
  @@index([shortCode, deletedAt])
  @@map("links")
}

/// Foundation for the future analytics engine (Sprint 3+). Written
/// asynchronously via a BullMQ job enqueued from the redirect path — never
/// written synchronously inline with a redirect response, so a slow
/// analytics write can never slow down a redirect.
model ClickEvent {
  id          String   @id @default(uuid()) @db.Uuid
  linkId      String   @db.Uuid
  link        Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  /// Denormalized from the link at write time so workspace-scoped click
  /// queries (once analytics exists) don't need to join through Link.
  workspaceId String   @db.Uuid
  occurredAt  DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  referer     String?
  createdAt   DateTime @default(now())

  @@index([linkId])
  @@index([workspaceId])
  @@index([occurredAt])
  @@map("click_events")
}

// ---------------------------------------------------------------------------
// Platform / Admin
// ---------------------------------------------------------------------------

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?    @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}
