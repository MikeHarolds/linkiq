# ==============================
# LinkIQ API — Environment Vars
# ==============================

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# --- Database (Prisma) ---
DATABASE_URL="postgresql://linkiq:change_me_dev_password@localhost:5432/linkiq?schema=public"

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Demo accounts (seed only, dev/staging) ---
DEMO_USER_EMAIL=demo@linkiq.com
DEMO_USER_PASSWORD=Demo@12345
DEMO_ADMIN_EMAIL=admin@linkiq.com
DEMO_ADMIN_PASSWORD=Admin@12345
