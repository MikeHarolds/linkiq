# ==============================
# LinkIQ API — Environment Vars
# ==============================

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Database (Prisma) ---
DATABASE_URL="postgresql://linkiq:change_me_dev_password@localhost:5432/linkiq?schema=public"

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
# Access tokens are short-lived JWTs (Authorization: Bearer header, kept in
# memory on the frontend — never persisted to localStorage/sessionStorage).
# Refresh tokens are opaque, random, DB-backed, and delivered only via an
# httpOnly/Secure cookie — this is what makes "logout everywhere" and
# revocation possible (a JWT refresh token can't be revoked before it expires).
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
REFRESH_COOKIE_NAME=linkiq_refresh_token
COOKIE_DOMAIN=
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Demo accounts (seed only, dev/staging) ---
DEMO_USER_EMAIL=demo@linkiq.com
DEMO_USER_PASSWORD=Demo@12345
DEMO_ADMIN_EMAIL=admin@linkiq.com
DEMO_ADMIN_PASSWORD=Admin@12345
