# ==============================
# LinkIQ API — Environment Vars
# ==============================

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Public-facing origin LinkIQ redirects live on — used to build the exact
# URL every QR code encodes (https://$APP_URL/$shortCode?utm_...). Should
# match the frontend's NEXT_PUBLIC_APP_URL in production; they're
# separate variables because the API and web app can be deployed and
# scaled independently.
APP_URL=http://localhost:3000

# --- Database (Prisma) ---
DATABASE_URL="postgresql://linkiq:change_me_dev_password@localhost:5432/linkiq?schema=public"

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
# Access tokens are short-lived JWTs (Authorization: Bearer header, kept in
# memory on the frontend — never persisted to localStorage/sessionStorage).
# Refresh tokens are opaque, random, DB-backed, and delivered only via an
# httpOnly/Secure cookie — this is what makes "logout everywhere" and
# revocation possible (a JWT refresh token can't be revoked before it expires).
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
REFRESH_COOKIE_NAME=linkiq_refresh_token
COOKIE_DOMAIN=
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Analytics (Sprint 3) ---
# Salts the visitor-hash computation (see docs/architecture/analytics.md
# §4) — set a real random value in any shared environment. Rotating this
# changes future visitor hashes only; historical events are unaffected.
VISITOR_HASH_SALT=change_me_visitor_hash_salt
# Set to "none" to disable geographic resolution entirely (all events
# report country/region/city as null/"Unknown"). Any other value (or
# unset) uses the default geoip-country provider.
GEO_IP_PROVIDER=

# --- Custom Domains (Sprint 6) ---
# Extra hostnames (comma-separated) treated as the default LinkIQ host in
# addition to APP_URL's own hostname and the always-default loopback
# hostnames (localhost/127.0.0.1/::1) — useful in local dev/staging for
# exercising the custom-domain code path without real DNS.
REDIRECT_DEFAULT_HOSTS=
# "dns" performs a real DNS TXT lookup against the domain being verified;
# "mock" (also auto-selected whenever NODE_ENV=test) deterministically
# succeeds for any domain prefixed "verified-" and fails otherwise, with
# no real DNS record required — see DomainVerificationProvider.
DOMAIN_VERIFICATION_MODE=dns

# --- Demo accounts (seed only, dev/staging) ---
DEMO_USER_EMAIL=demo@linkiq.com
DEMO_USER_PASSWORD=Demo@12345
DEMO_ADMIN_EMAIL=admin@linkiq.com
DEMO_ADMIN_PASSWORD=Admin@12345
