# ==============================
# LinkIQ API — Environment Vars
# ==============================

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Public-facing origin LinkIQ redirects live on — used to build the exact
# URL every QR code encodes (https://$APP_URL/$shortCode?utm_...). Should
# match the frontend's NEXT_PUBLIC_APP_URL in production; they're
# separate variables because the API and web app can be deployed and
# scaled independently.
APP_URL=http://localhost:3000

# --- Database (Prisma) ---
DATABASE_URL="postgresql://linkiq:change_me_dev_password@localhost:5432/linkiq?schema=public"

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
# Access tokens are short-lived JWTs (Authorization: Bearer header, kept in
# memory on the frontend — never persisted to localStorage/sessionStorage).
# Refresh tokens are opaque, random, DB-backed, and delivered only via an
# httpOnly/Secure cookie — this is what makes "logout everywhere" and
# revocation possible (a JWT refresh token can't be revoked before it expires).
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
REFRESH_COOKIE_NAME=linkiq_refresh_token
COOKIE_DOMAIN=
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Analytics (Sprint 3) ---
# Salts the visitor-hash computation (see docs/architecture/analytics.md
# §4) — set a real random value in any shared environment. Rotating this
# changes future visitor hashes only; historical events are unaffected.
VISITOR_HASH_SALT=change_me_visitor_hash_salt
# Set to "none" to disable geographic resolution entirely (all events
# report country/region/city as null/"Unknown"). Any other value (or
# unset) uses the default geoip-country provider.
GEO_IP_PROVIDER=

# --- Custom Domains (Sprint 6) ---
# Extra hostnames (comma-separated) treated as the default LinkIQ host in
# addition to APP_URL's own hostname and the always-default loopback
# hostnames (localhost/127.0.0.1/::1) — useful in local dev/staging for
# exercising the custom-domain code path without real DNS.
REDIRECT_DEFAULT_HOSTS=
# "dns" performs a real DNS TXT lookup against the domain being verified;
# "mock" (also auto-selected whenever NODE_ENV=test) deterministically
# succeeds for any domain prefixed "verified-" and fails otherwise, with
# no real DNS record required — see DomainVerificationProvider.
DOMAIN_VERIFICATION_MODE=dns

# --- Billing (Sprint 7) ---
# Selects the BillingProvider implementation via the BILLING_PROVIDER DI
# token — "development" (default, also always used when unset) never
# calls out to a real payment processor; every mutation applies directly
# to LinkIQ's own database. Set to "paystack" to use the real provider
# (Sprint 10) — see docs/architecture/paystack-integration.md.
BILLING_PROVIDER=development
# Placeholder only — not used by any provider shipped so far. Left blank.
BILLING_PROVIDER_API_KEY=

# --- Payments: Paystack (Sprint 10) ---
# Server-only. Also used to verify inbound webhook signatures — Paystack
# has no separate webhook-signing secret, unlike Stripe or LinkIQ's own
# outbound webhooks (Sprint 9). Test vs. live mode is inferred from this
# key's own prefix (sk_test_/sk_live_), not a separate flag.
PAYSTACK_SECRET_KEY=
# Safe to expose client-side. Unused server-side by the redirect-based
# checkout this sprint ships; kept for a possible future inline checkout.
PAYSTACK_PUBLIC_KEY=
# How long a subscription may stay PAST_DUE (a failed recurring charge
# Paystack itself never retries) before it's derived as EXPIRED.
PAYSTACK_PAST_DUE_GRACE_DAYS=7

# --- Webhooks (Sprint 9) ---
# Encrypts webhook signing secrets at rest (AES-256-GCM) so LinkIQ can
# reuse them to sign future deliveries — set a real random value in any
# shared environment. Rotating this makes every existing endpoint's
# stored secret undecryptable, so treat it like a database credential.
WEBHOOK_SECRET_ENCRYPTION_KEY=change_me_webhook_secret_encryption_key
# Per-attempt HTTP timeout (ms) for outbound webhook deliveries.
WEBHOOK_TIMEOUT_MS=10000
# BullMQ retry attempts (includes the first try) before a delivery is
# marked EXHAUSTED.
WEBHOOK_MAX_ATTEMPTS=5
# Exponential backoff base delay (ms) between automatic retry attempts.
WEBHOOK_BACKOFF_BASE_MS=1000
# Consecutive terminal-delivery failures before an endpoint is
# automatically DISABLED (history is preserved; deliveries stop).
WEBHOOK_AUTO_DISABLE_THRESHOLD=10
# Dev/test-only exception to the HTTPS-required rule: allows "http://"
# webhook endpoint URLs, but ONLY when they resolve exclusively to
# loopback addresses (127.0.0.1/::1) — every other private/reserved IP
# range stays blocked regardless of this flag. Leave unset/false in
# production.
WEBHOOK_ALLOW_HTTP_LOCALHOST=true

# --- Demo accounts (seed only, dev/staging) ---
DEMO_USER_EMAIL=demo@linkiq.com
DEMO_USER_PASSWORD=Demo@12345
DEMO_ADMIN_EMAIL=admin@linkiq.com
DEMO_ADMIN_PASSWORD=Admin@12345
